# The fixed demo needs no variables and never calls Supabase.
# This file is documentation; the application does not automatically load .env.
# Set these in the server's process environment only after configuring the project.
AUTH_ENABLED=false
APP_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOW_LOOPBACK_HTTP=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Optional shorter limits in seconds; defaults are 30 minutes / 12 hours.
# AUTH_IDLE_SECONDS=1800
# AUTH_ABSOLUTE_SECONDS=43200
# Never use a service_role/secret key. Never place credentials in browser code.
