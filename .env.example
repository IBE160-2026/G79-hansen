# The fixed demo needs no variables and never calls Supabase.
# This file is documentation; the application does not automatically load .env.
# Set these in the server's process environment only after configuring the project.
AUTH_ENABLED=false
APP_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOW_LOOPBACK_HTTP=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Email dispatch fails closed until a dedicated journal is explicitly initialized.
# Password login and the fixed demo do not require this setting.
# AUTH_EMAIL_ADMISSION_PATH=.auth-email-admission.sqlite3
# Offline creation of NEW state only:
# uv run --locked python -m scripts.email_admission init .auth-email-admission.sqlite3
# Preserve the journal and SQLite sidecars; never reset after restart/uncertainty.
# Shared signup/recovery limits: 2 globally and 1 per normalized recipient / hour.
# Optional shorter limits in seconds; defaults are 30 minutes / 12 hours.
# AUTH_IDLE_SECONDS=1800
# AUTH_ABSOLUTE_SECONDS=43200
# Never use a service_role/secret key. Never place credentials in browser code.

# Private generation is disabled unless explicitly enabled in the process.
MODEL_ENABLED=false
OPENAI_API_KEY=YOUR_LOCAL_API_KEY
MODEL_BUDGET_PATH=.model-budget.json
SAVE_ENABLED=false
# Ignored server file, created once by scripts.save_backend_key after approval.
SAVE_BACKEND_KEY_PATH=.save-backend-key
# Original-file verification uses uncached S3 with the same user's JWT and RLS.
# Legacy public anon key required by S3; never use privileged S3/service keys.
SUPABASE_S3_REGION=YOUR_PROJECT_REGION
SUPABASE_S3_KEY_ID=YOUR_PROJECT_REF
SUPABASE_S3_ANON_KEY=YOUR_LEGACY_ANON_KEY
# Initialize ONCE after approval: uv run python -m scripts.model_budget init .model-budget.json
# Never reset this USD 5 lifetime ceiling or refund uncertain requests.
