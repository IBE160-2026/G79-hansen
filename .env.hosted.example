# Copy to ignored .env.hosted for local preparation; no Funnel activation is performed.
# This is separate from .env. Ambient process variables override this file.
AUTH_ENABLED=true
# Exact candidate HTTPS origin, including candidate proxy port 10000; no path.
APP_ORIGIN=https://YOUR_HOST.ts.net:10000
AUTH_ALLOW_LOOPBACK_HTTP=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Keep existing persistent state. The launcher never creates or resets any state.
MODEL_ENABLED=false
OPENAI_API_KEY=YOUR_EXISTING_OPENAI_API_KEY
MODEL_BUDGET_PATH=.model-budget.json
SAVE_ENABLED=false
SAVE_BACKEND_KEY_PATH=.save-backend-key
SUPABASE_S3_REGION=eu-west-3
SUPABASE_S3_KEY_ID=YOUR_PROJECT_REF
SUPABASE_S3_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Empty explicitly disables signup/recovery email; password login still works.
# To enable email use an EXISTING valid journal; do not reset it on restart.
AUTH_EMAIL_ADMISSION_PATH=
# AUTH_EMAIL_ADMISSION_PATH=.auth-email-admission.sqlite3
